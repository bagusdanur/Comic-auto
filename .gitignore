# Secrets — never commit. The vault holds the real values.
.env
.env.*
!.env.example
.api-token

# Local edit backups and ad-hoc snapshots
*.before-*
*.bak
*.bak-*
backups/
build-backups/
deploy-backups/

# Runtime data: job artifacts, databases, caches
data/
output/
artifacts/
__pycache__/
*.py[cod]

# Large model weights (hundreds of MB; re-downloadable, never versioned)
models/
vendor/xianscan/ml/models/

# Virtualenvs
.venv/
vendor/xianscan/ml/.venv/

# Node
node_modules/
api/dist/

# Machine-generated debug artifacts seen in this repo
--db
*.pid
*.log
